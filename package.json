{
  "name": "yjb-platform-design-history",
  "version": "1.0.0",
  "author": "Youth Justice Board of England and Wales: YJB Platform team",
  "description": "A place for documenting YJB Platform service designs",
  "keywords": [
    "design-history",
    "government",
    "govuk",
    "yjb",
    "yjb-platform",
    "youth-justice-board"
  ],
  "license": "MIT",
  "scripts": {
    "build": "npm-run-all --serial build:*",
    "build:files": "eleventy",
    "build:styles": "sass app/_stylesheets:public/stylesheets --load-path node_modules/govuk-frontend/dist/ --load-path app --quiet-deps",
    "preserve": "npm run build",
    "serve": "http-server ./_site",
    "test": "standard",
    "watch:files": "eleventy --serve --quiet",
    "watch:styles": "sass app/_stylesheets:public/stylesheets --load-path node_modules/govuk-frontend/dist/ --load-path app --quiet-deps --watch",
    "watch": "npm-run-all --parallel watch:*",
    "dev": "npm run watch",
    "prestart": "npm run build",
    "start": "npm run watch:files"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@x-govuk/govuk-eleventy-plugin": "^9.0.1",
    "govuk-frontend": "^6.2.0",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "standard": "^17.1.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
